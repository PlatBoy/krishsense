NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_32_plus_character_secret
JWT_EXPIRES_IN=7d

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/krishsense?retryWrites=true&w=majority

# Google AI Studio / Gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
CLOUDINARY_FOLDER=krishsense/soil-photos

# Optional first admin seed. Set once before first production boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_8_plus_character_password
ADMIN_NAME=KrishiSense Admin
